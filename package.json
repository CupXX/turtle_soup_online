{
  "name": "multiplayer-turtle-soup",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "worker:start": "node --env-file=.env.local --import tsx -e \"import('./services/judge-worker/src/main.ts').then(({ startWorker }) => startWorker())\"",
    "benchmark:mosquito": "node --env-file=.env.local --import tsx services/judge-worker/benchmarks/mosquito-comparison.ts",
    "benchmark:mosquito:25": "node --env-file=.env.local --import tsx services/judge-worker/benchmarks/mosquito-question-judge-live.ts",
    "benchmark:all-choices:30": "node --env-file=.env.local --import tsx services/judge-worker/benchmarks/all-choices-correct-question-judge-live.ts",
    "benchmark:key-points:v3": "node --env-file=.env.local --import tsx services/judge-worker/benchmarks/key-point-extraction-v3-live.ts",
    "verify:first-playable-loop": "node scripts/verify-first-playable-loop.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "eslint": "10.8.1",
    "supabase": "2.114.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
