{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://turtle-soup.local/schemas/key-point-extraction-result.schema.json",
  "title": "Key point extraction result",
  "type": "object",
  "additionalProperties": false,
  "required": ["key_points"],
  "properties": {
    "key_points": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content"],
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    }
  }
}
